---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/primitives/Container.astro';
import PageGrid from '../../components/foundation/PageGrid.astro';
import GridItem from '../../components/foundation/GridItem.astro';
import TechnicalDivider from '../../components/foundation/TechnicalDivider.astro';
---
<BaseLayout title="Grid Foundation — Dev" description="Internal 12, 8, and 4 column grid proof." noindex>
  <section class="grid-dev"><Container><h1>12 / 8 / 4<br />page grid.</h1><TechnicalDivider label="GRID SYSTEM" index="01" /><PageGrid className="grid-proof"><GridItem span={8}><div>SPAN / 08</div></GridItem><GridItem span={4}><div>SPAN / 04</div></GridItem><GridItem start={3} span={7}><div>START / 03 · SPAN / 07</div></GridItem></PageGrid></Container></section>
</BaseLayout>
<style>
  .grid-dev { padding-block:var(--space-section-md); }.grid-dev h1 { margin-bottom:var(--space-section-sm); font:560 var(--type-display-xl)/.9 var(--font-sans); letter-spacing:-.04em; }.grid-dev :global(.grid-proof) { margin-top:var(--space-8); }.grid-dev :global(.grid-proof > div > div) { min-height:12rem; padding:var(--space-4); border:1px solid var(--color-border); color:var(--color-muted); font:500 var(--type-meta) var(--font-mono); }
</style>
