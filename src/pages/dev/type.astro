---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/primitives/Container.astro';
const samples = [
  ['Display XXL','I build AI products with taste and technical depth.','type-display'],
  ['Display / Vietnamese','Kiến trúc tạo nên trải nghiệm sản phẩm.','type-display'],
  ['Heading','Kỹ thuật, dữ liệu, và quyền sở hữu.','type-heading'],
  ['Editorial','The tools matter. The boundaries matter more.','type-editorial'],
  ['Body','A product system remains understandable when every layer has a clear responsibility.','type-body'],
  ['Metadata','STATE / DATA / OWNERSHIP / CURRENT','type-meta'],
  ['Annotation','hello there — build the real thing','type-annotation'],
];
---
<BaseLayout title="Type Foundation — Dev" description="Internal typography foundation proof." noindex>
  <section class="type-dev"><Container><h1>Typography<br />foundation.</h1><div class="type-list">{samples.map(([label,copy,className])=><article><span>{label}</span><p class={className}>{copy}</p></article>)}</div><p class="glyph-proof">Sản phẩm · Trải nghiệm · Kiến trúc · Kỹ thuật · Dữ liệu · ă â ê ô ơ ư đ · ứ ừ ử ữ ự</p></Container></section>
</BaseLayout>
<style>
  .type-dev { padding-block:var(--space-section-md); }.type-dev h1 { font:560 var(--type-display-xl)/.9 var(--font-sans); letter-spacing:-.04em; }
  .type-list { display:grid; gap:var(--space-8); margin-top:var(--space-section-md); }.type-list article { padding-top:var(--space-4); border-top:1px solid var(--color-border); }.type-list article > span,.glyph-proof { color:var(--color-muted); font:500 var(--type-meta)/1.6 var(--font-mono); letter-spacing:.08em; text-transform:uppercase; }.type-list p { margin-top:var(--space-6); }.glyph-proof { margin-top:var(--space-section-md); }
</style>
