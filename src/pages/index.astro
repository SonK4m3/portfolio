---
import BaseLayout from '../layouts/BaseLayout.astro'; import Container from '../components/Container.astro'; import Section from '../components/Section.astro'; import SectionHeading from '../components/SectionHeading.astro'; import { getCollection } from 'astro:content'; import { principles } from '../data/site';
const work = (await getCollection('work', ({ data }) => data.published)).sort((a,b) => a.data.order-b.data.order);
---
<BaseLayout><Section class="hero"><Container><span class="eyebrow">Product Engineer</span><h1>Turning complex systems into simple products.</h1><p>I work across product, interface, architecture and AI to bring ideas from ambiguity to production.</p><a class="hero-link" href="#work">Explore selected work <span aria-hidden="true">↗</span></a></Container></Section><Section id="work"><Container><SectionHeading eyebrow="01 / Selected work" title="Selected work" /><div class="work-list">{work.map((entry, index) => <a class="project" href={`/work/${entry.id}`}><span class="project-index">{String(index+1).padStart(2,'0')}</span><div><h3>{entry.data.title}</h3><p>{entry.data.description}</p></div><span class="project-meta">{entry.data.role ?? '[ROLE TBD]'}</span></a>)}</div></Container></Section><Section><Container><SectionHeading eyebrow="02 / Principles" title="How I build." /><div class="principles">{principles.map((principle) => <article class="principle"><h3>{principle.title}</h3><p>{principle.body}</p></article>)}</div></Container></Section><Section><Container><SectionHeading eyebrow="03 / Playground" title="Experiments, in progress." /><p class="about-preview muted">AI, RAG, agents, browser APIs, recording, desktop, and the systems that make new product ideas possible.</p></Container></Section><Section><Container><SectionHeading eyebrow="04 / About" title="A little context." /><p class="about-preview">I'm a Product Engineer interested in the space where software engineering, product thinking, and AI meet.</p><a class="hero-link" href="/about">More about me ↗</a></Container></Section></BaseLayout>
