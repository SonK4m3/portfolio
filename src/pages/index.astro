---
import BaseLayout from '../layouts/BaseLayout.astro'; import Container from '../components/Container.astro'; import Section from '../components/Section.astro'; import SectionHeading from '../components/SectionHeading.astro'; import Heading from '../components/typography/Heading.astro'; import Lead from '../components/typography/Lead.astro'; import ProjectCard from '../components/work/ProjectCard.astro'; import { getCollection } from 'astro:content'; import { principles } from '../data/principles';
const work = (await getCollection('work', ({ data }) => data.published)).sort((a,b) => a.data.order-b.data.order);
---
<BaseLayout><Section class="hero"><Container><span class="eyebrow">Product Engineer</span><Heading as="h1" size="display">Turning complex systems into simple products.</Heading><Lead>I work across product, interface, architecture and AI to bring ideas from ambiguity to production.</Lead><a class="hero-link" href="#work">Explore selected work <span aria-hidden="true">↗</span></a></Container></Section><Section id="work"><Container><SectionHeading eyebrow="01 / Selected work" title="Selected work" /><div class="work-list">{work.map((entry, index) => <ProjectCard index={String(index+1).padStart(2,'0')} title={entry.data.title} description={entry.data.description} href={`/work/${entry.id}`} role={entry.data.role} />)}</div></Container></Section><Section><Container><SectionHeading eyebrow="02 / Principles" title="How I build." /><div class="principles">{principles.map((principle) => <article class="principle"><h3>{principle.title}</h3><p>{principle.body}</p></article>)}</div></Container></Section><Section><Container><SectionHeading eyebrow="03 / Playground" title="Experiments, in progress." /><p class="about-preview muted">AI, RAG, agents, browser APIs, recording, desktop, and the systems that make new product ideas possible.</p></Container></Section><Section><Container><SectionHeading eyebrow="04 / About" title="A little context." /><p class="about-preview">I'm a Product Engineer interested in the space where software engineering, product thinking, and AI meet.</p><a class="hero-link" href="/about">More about me ↗</a></Container></Section></BaseLayout>
