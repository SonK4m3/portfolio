---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ComponentDocLayout from '../../layouts/ComponentDocLayout.astro';
import { assertRegistryMatches, getComponentRegistryEntry } from '../../lib/components/registry';

export async function getStaticPaths() {
  const entries = (await getCollection('components', ({ data }) => data.published)).sort((a,b) => a.data.order - b.data.order);
  assertRegistryMatches(entries.map((entry) => entry.data.slug));
  return entries.map((entry, index) => ({
    params: { slug: entry.data.slug },
    props: { entry, previous: entries[index - 1]?.data, next: entries[index + 1]?.data },
  }));
}

interface Props {
  entry: CollectionEntry<'components'>;
  previous?: CollectionEntry<'components'>['data'];
  next?: CollectionEntry<'components'>['data'];
}
const { entry, previous, next } = Astro.props as Props;
const { Content } = await render(entry);
const Preview = getComponentRegistryEntry(entry.data.slug).preview;
---
<ComponentDocLayout entry={entry.data} Preview={Preview} previous={previous} next={next}>
  <Content />
</ComponentDocLayout>
