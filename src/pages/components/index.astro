---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/primitives/Container.astro';
import FigureLabel from '../../components/editorial/FigureLabel.astro';
import DossierMatrix from '../../components/system/DossierMatrix.astro';
import TechnicalDivider from '../../components/foundation/TechnicalDivider.astro';
import PreviewCanvas from '../../components/docs/PreviewCanvas.astro';
import ComponentStatus from '../../components/docs/ComponentStatus.astro';
import { assertRegistryMatches, getComponentRegistryEntry } from '../../lib/components/registry';

const components = (await getCollection('components', ({ data }) => data.published)).sort((a,b) => a.data.order - b.data.order);
assertRegistryMatches(components.map((entry) => entry.data.slug));
const categories = ['all', 'system', 'editorial', 'interaction'] as const;
const metrics = [
  { label:'Components', value:String(components.length).padStart(2,'0') },
  { label:'System views', value:String(components.filter(({data}) => data.category === 'system').length).padStart(2,'0') },
  { label:'Interactive', value:String(components.filter(({data}) => data.capabilities?.includes('interaction') || data.category === 'interaction').length).padStart(2,'0') },
  { label:'Runtime', value:'Astro / Native JS' },
];
---
<BaseLayout title="Components — Son Nguyen" description="A public component laboratory documenting the design intent, production API, accessibility, and performance of six signature Astro components.">
  <div class="components-page">
    <Container>
      <header class="components-hero">
        <FigureLabel as="div" type="CMP" index="006" title="PUBLIC COMPONENT LABORATORY" signal="2026" />
        <h1>Small interface systems,<br />designed with intent.</h1>
        <div class="hero-copy"><p>A collection built from real product and portfolio needs—documented to show why each component exists, how it behaves, and where it is already working.</p><span>DESIGN SYSTEM → COMPONENT ENGINEERING → DX</span></div>
        <DossierMatrix items={metrics} columns={2} />
      </header>

      <section class="catalogue" aria-labelledby="catalogue-title" data-component-catalogue>
        <div class="catalogue-heading"><TechnicalDivider label="Catalogue" index={`${String(components.length).padStart(2,'0')} production components`} /><h2 id="catalogue-title">The archive is the interface.</h2></div>
        <div class="catalogue-filters" role="group" aria-label="Filter components by category">
          {categories.map((category) => <button type="button" data-category-filter={category} aria-pressed={category === 'all'}>{category}</button>)}
        </div>

        <div class="catalogue-layout">
          <div class="component-list">
            {components.map((entry, index) => {
              const Preview = getComponentRegistryEntry(entry.data.slug).preview;
              return <article class="component-entry" data-component-entry data-category={entry.data.category} data-slug={entry.data.slug}>
                <a class="component-row" href={`/components/${entry.data.slug}`} data-component-trigger aria-describedby={`${entry.data.slug}-description`}>
                  <span class="component-index">{entry.data.id}</span>
                  <div><h3>{entry.data.title}</h3><p id={`${entry.data.slug}-description`}>{entry.data.description}</p></div>
                  <dl><div><dt>Category</dt><dd>{entry.data.category}</dd></div><div><dt>Framework</dt><dd>{entry.data.framework.join(' / ')}</dd></div><div><dt>Used in</dt><dd>{entry.data.usedIn.map((item) => item.label).join(' / ')}</dd></div></dl>
                  <ComponentStatus status={entry.data.status} />
                  <span class="open-label">Open / {String(index + 1).padStart(2,'0')}</span>
                </a>
                <div class="mobile-preview"><PreviewCanvas toolbar={false} padding="md"><Preview /></PreviewCanvas></div>
              </article>;
            })}
          </div>

          <div class="catalogue-preview" aria-live="polite">
            <PreviewCanvas label="Active component" padding="md">
              {components.map((entry, index) => {
                const Preview = getComponentRegistryEntry(entry.data.slug).preview;
                return <div class="preview-entry" data-preview-entry={entry.data.slug} hidden={index !== 0}><Preview /></div>;
              })}
            </PreviewCanvas>
          </div>
        </div>
      </section>
    </Container>
  </div>
</BaseLayout>
<style>
  .components-page { padding-bottom:var(--space-section-lg); }
  .components-hero { min-height:calc(100svh - 4.5rem); display:grid; align-content:center; gap:var(--space-7); padding-block:var(--space-9); }
  .components-hero h1 { max-width:13ch; font:560 var(--type-display-xl)/.88 var(--font-sans); letter-spacing:-.04em; text-transform:uppercase; text-wrap:balance; }
  .hero-copy { display:grid; grid-template-columns:minmax(0,2fr) minmax(16rem,1fr); gap:var(--grid-gap); align-items:end; }
  .hero-copy p { max-width:52ch; color:var(--color-muted); font-size:var(--type-lead); text-wrap:pretty; }
  .hero-copy span { color:var(--color-muted); font:500 var(--type-meta)/1.5 var(--font-mono); letter-spacing:.1em; }
  .catalogue { padding-top:var(--space-section-md); }
  .catalogue-heading { display:grid; gap:var(--space-7); margin-bottom:var(--space-7); }
  .catalogue-heading h2 { max-width:12ch; font:560 var(--type-display-md)/.94 var(--font-sans); letter-spacing:-.035em; text-transform:uppercase; text-wrap:balance; }
  .catalogue-filters { display:flex; flex-wrap:wrap; border-block:1px solid var(--color-border); margin-bottom:var(--space-7); }
  .catalogue-filters button { min-height:2.75rem; padding:.75rem var(--space-4); border:0; border-right:1px solid var(--color-border); background:transparent; color:var(--color-muted); font:500 var(--type-meta)/1 var(--font-mono); letter-spacing:.1em; text-transform:uppercase; cursor:pointer; }
  .catalogue-filters button[aria-pressed='true'] { color:var(--color-foreground); box-shadow:inset 0 -1px 0 var(--color-signal); }
  .catalogue-layout { display:grid; grid-template-columns:minmax(0,5fr) minmax(24rem,5fr); gap:calc(var(--grid-gap) * 2); align-items:start; }
  .component-list { border-top:1px solid var(--color-border); }
  .component-entry[hidden] { display:none; }
  .component-row { position:relative; display:grid; grid-template-columns:5rem minmax(0,1fr) minmax(12rem,1fr); gap:var(--grid-gap); padding:var(--space-6) 0; border-bottom:1px solid var(--color-border); }
  .component-index,.open-label { color:var(--color-muted); font:500 var(--type-meta)/1.2 var(--font-mono); letter-spacing:.1em; text-transform:uppercase; font-variant-numeric:tabular-nums; }
  .component-row h3 { font:560 var(--type-subheading)/1 var(--font-sans); letter-spacing:-.03em; text-transform:uppercase; text-wrap:balance; }
  .component-row p { max-width:45ch; margin-top:var(--space-3); color:var(--color-muted); font-size:var(--type-small); text-wrap:pretty; }
  .component-row dl { display:grid; gap:var(--space-3); margin:0; }
  .component-row dl > div { display:grid; grid-template-columns:5rem 1fr; gap:var(--space-2); }
  .component-row dt,.component-row dd { margin:0; font:500 var(--type-meta)/1.3 var(--font-mono); text-transform:uppercase; }
  .component-row dt { color:var(--color-muted); }.component-row dd { color:var(--color-foreground); }
  .component-row :global(.component-status) { grid-column:2; }
  .open-label { grid-column:3; text-align:right; }
  .component-row::after { content:''; position:absolute; inset:0; z-index:-1; background:var(--color-surface); opacity:0; transition:opacity var(--motion-fast) var(--ease-system); }
  .component-row:hover::after,.component-row:focus-visible::after,.component-entry[data-active='true'] .component-row::after { opacity:1; }
  .catalogue-preview { position:sticky; top:6.5rem; }
  .preview-entry[hidden] { display:none; }
  .mobile-preview { display:none; }
  @media (max-width:1023px) { .catalogue-layout { grid-template-columns:1fr; }.catalogue-preview { position:static; grid-row:1; }.component-row { grid-template-columns:4rem minmax(0,1fr) minmax(12rem,1fr); } }
  @media (max-width:767px) { .components-hero { min-height:auto; padding-block:var(--space-9); }.components-hero h1 { font-size:clamp(3.5rem,16vw,5.25rem); }.hero-copy { grid-template-columns:1fr; }.catalogue-preview { display:none; }.mobile-preview { display:block; margin-bottom:var(--space-7); }.component-row { grid-template-columns:3rem 1fr; }.component-row dl { grid-column:2; margin-top:var(--space-3); }.component-row :global(.component-status) { grid-column:2; }.open-label { grid-column:2; text-align:left; }.component-row dl > div { grid-template-columns:5.5rem 1fr; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-component-catalogue]').forEach((catalogue) => {
    const entries = [...catalogue.querySelectorAll<HTMLElement>('[data-component-entry]')];
    const previews = [...catalogue.querySelectorAll<HTMLElement>('[data-preview-entry]')];
    const filters = [...catalogue.querySelectorAll<HTMLButtonElement>('[data-category-filter]')];
    const activate = (slug: string) => {
      entries.forEach((entry) => entry.dataset.active = String(entry.dataset.slug === slug));
      previews.forEach((preview) => preview.hidden = preview.dataset.previewEntry !== slug);
    };
    entries.forEach((entry) => {
      const trigger = entry.querySelector<HTMLElement>('[data-component-trigger]');
      trigger?.addEventListener('pointerenter', () => activate(entry.dataset.slug ?? ''));
      trigger?.addEventListener('focus', () => activate(entry.dataset.slug ?? ''));
    });
    filters.forEach((filter) => filter.addEventListener('click', () => {
      const category = filter.dataset.categoryFilter ?? 'all';
      filters.forEach((item) => item.setAttribute('aria-pressed', String(item === filter)));
      entries.forEach((entry) => entry.hidden = category !== 'all' && entry.dataset.category !== category);
      const firstVisible = entries.find((entry) => !entry.hidden);
      if (firstVisible?.dataset.slug) activate(firstVisible.dataset.slug);
    }));
    if (entries[0]?.dataset.slug) activate(entries[0].dataset.slug);
  });
</script>
