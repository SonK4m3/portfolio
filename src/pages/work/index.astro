---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Container from '../../components/Container.astro'; import ProjectCard from '../../components/work/ProjectCard.astro'; import { getCollection } from 'astro:content'; const work=(await getCollection('work',({data})=>data.published)).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout title="Work — Product Engineer"><section class="section"><Container><span class="eyebrow">Selected work</span><h1 class="text-heading-xl page-title">Work</h1><div class="work-list page-intro">{work.map((entry)=><ProjectCard index={String(entry.data.order).padStart(2,'0')} title={entry.data.title} description={entry.data.description} href={`/work/${entry.id}`} role="View ↗" />)}</div></Container></section></BaseLayout>
