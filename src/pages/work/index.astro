---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Arrow from '../../components/editorial/Arrow.astro';
import { Image } from 'astro:assets';
import collectedThought from '../../assets/editorial/collected-thought.png';
import { getCollection } from 'astro:content';
const work = (await getCollection('work', ({data}) => data.published)).sort((a,b) => a.data.order-b.data.order);
---
<BaseLayout title="Work — Product Engineer" description="Selected product engineering work by Son Nguyen. Explore NoteX, from product decisions to frontend architecture.">
  <section class="work-index"><Container>
    <div class="index-intro"><h1>Selected work<span>.</span></h1><p>Products, and the thinking<br />that holds them together.</p></div>
    {work.map(entry => <article class="index-entry">
      {entry.id === 'notex' && <figure><a href="/work/notex" aria-label="Explore NoteX"><Image src={collectedThought} alt="A sculptural wave of paper sheets on a deep red ground." widths={[480,800,1200,1536]} sizes="(max-width:700px) calc(100vw - 40px), 65vw" format="webp" quality={85} loading="eager" /></a><figcaption>Collected thought / AI-generated conceptual cover</figcaption></figure>}
      <div class="entry-copy"><h2><a href={`/work/${entry.id}`}>{entry.data.title} <Arrow /></a></h2><p>{entry.data.description}</p><span>{entry.data.role ?? '[ROLE TBD]'}</span><a class="case-link" href={`/work/${entry.id}`}>Read the case study <Arrow direction="right" /></a></div>
    </article>)}
  </Container></section>
</BaseLayout>
<style>
  .work-index { padding-block:4rem 7rem; }.index-intro { display:flex; justify-content:space-between; align-items:end; gap:2rem; margin-bottom:4rem; }.index-intro h1 { font-size:clamp(3rem,7vw,6rem); line-height:1; letter-spacing:-.04em; font-weight:500; }.index-intro h1 > span { color:var(--accent); }.index-intro p { color:var(--muted); font-size:1.125rem; line-height:1.5; }
  .index-entry { display:grid; grid-template-columns:8fr 3fr; gap:8%; margin-top:3rem; }.index-entry figure { margin:0; }.index-entry img { width:100%; height:auto; display:block; }.index-entry figcaption { font:400 .6875rem/1.6 var(--font-mono); color:var(--muted); margin-top:1rem; }.entry-copy { align-self:center; }.entry-copy h2 a { display:flex; align-items:center; justify-content:space-between; gap:1rem; font-size:clamp(2rem,4vw,4rem); font-weight:500; }.entry-copy > p { margin-top:2rem; font-size:1.25rem; }.entry-copy > span { display:block; font:400 .6875rem/1.7 var(--font-mono); color:var(--muted); margin-top:2rem; }.case-link { display:flex; align-items:center; justify-content:space-between; gap:1rem; min-height:2.75rem; border-bottom:1px solid currentColor; margin-top:3rem; font-size:.8125rem; }
  @media (max-width:700px) { .work-index { padding-block:3rem 5rem; }.index-intro { display:block; margin-bottom:2rem; }.index-intro h1 { font-size:clamp(2.5rem,11vw,4rem); }.index-intro p { margin-top:1.5rem; }.index-entry { grid-template-columns:1fr; gap:2rem; }.entry-copy > p,.entry-copy > span { margin-top:1rem; }.case-link { margin-top:1.5rem; } }
</style>
