---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Link from '../components/typography/Link.astro';
import { siteConfig } from '../data/site';

const metadata = [
  ['Role', siteConfig.role],
  ['Focus', 'AI product / Frontend architecture'],
  ['Current', 'NoteX'],
  ['Location', siteConfig.location],
  ['Languages', 'Vietnamese / English'],
  ['Status', 'Open to interesting collaborations'],
];
const capabilities = [
  ['01', 'Core web', 'Next.js / React / TypeScript'],
  ['02', 'State & data', 'Zustand / React Query / Axios / Dexie'],
  ['03', 'Realtime', 'SSE'],
  ['04', 'UI & interaction', 'Tailwind / accessible primitives / motion'],
  ['05', 'Content & media', 'TipTap / PDF / Wavesurfer / Markmap'],
  ['06', 'Platform', 'Browser extension / Tauri'],
  ['07', 'AI', 'AI SDK / RAG / workflows / context engineering'],
];
const projects = [
  ['01', 'NoteX', 'Product', 'Active', '/work/notex'],
  ['02', 'AI LaTeX Generator', 'AI systems', 'Active', '/playground'],
  ['03', 'AI Skills', 'Experiment', 'Ongoing', '/playground'],
];
---
<BaseLayout title="About — Product Engineer" description="A personal technical dossier for Son Nguyen, Product Engineer focused on AI products and frontend architecture.">
  <section class="dossier-hero" aria-labelledby="about-title">
    <Container>
      <div class="dossier-topline"><span>ABOUT / PROFILE</span><span>2026 / VIETNAM</span></div>
      <div class="dossier-hero-grid"><div><p class="dossier-label">PERSONAL TECHNICAL DOSSIER</p><h1 id="about-title">Son<br />Nguyen</h1><p class="hero-role">Product Engineer<br />Frontend Lead<br />AI Product</p></div><div class="profile-mark"><span>FIG.01</span><strong>How I work<br />is part of<br />what I build.</strong><small>[PORTRAIT / OPTIONAL ASSET]</small></div></div>
    </Container>
  </section>

  <section class="quick-info" aria-labelledby="quick-info-title"><Container><div class="section-label"><span id="quick-info-title">QUICK INFO</span><small>READ / 01</small></div><dl>{metadata.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></Container></section>

  <section class="about-introduction" aria-labelledby="intro-title"><Container><div class="section-label"><span id="intro-title">INTRODUCTION</span><small>NOTE / 02</small></div><div class="intro-grid"><div><p class="caveat">hello there →</p><h2>I’m a Product Engineer with a strong foundation in frontend architecture.</h2></div><div><p class="intro-serif">I’m usually most interested in the moment when a product problem stops being just a design problem or just an engineering problem.</p><p class="intro-body">That middle space is where I like to work. I care about the behavior that needs to exist, the boundaries that keep it understandable, and the details that make the final product feel considered.</p></div></div></Container></section>

  <section class="capability-section" aria-labelledby="capability-title"><Container><div class="section-label"><span id="capability-title">STACK / CAPABILITIES</span><small>REGISTRY / 03</small></div><div class="capability-list">{capabilities.map(([index,name,tools])=><div class="capability-row"><span>{index}</span><strong>{name}</strong><p>{tools}</p></div>)}</div><p class="verification-note">Technology list is a working profile and should be verified against the current production stack.</p></Container></section>

  <section class="experience-section" aria-labelledby="experience-title"><Container><div class="section-label"><span id="experience-title">EXPERIENCE</span><small>RECORD / 04</small></div><article class="experience-record"><div class="record-index">01</div><div><p class="record-company">NOTEX / [VERIFY COMPANY NAME]</p><h2>Product Engineer<br />/ Frontend Lead</h2><p class="record-period">2024 — Present / [VERIFY]</p></div><ul><li>Own frontend architecture and technical decisions across product surfaces.</li><li>Work with Product, BA, and Backend on product and system design.</li><li>Lead solution reviews, code reviews, and boundaries between layers.</li><li>Help evolve NoteX across web, extension, and desktop contexts.</li></ul></article></Container></section>

  <section class="now-section" aria-labelledby="now-title"><Container><div class="section-label"><span id="now-title">NOW / 2026</span><small>TEMPORAL PROFILE / 05</small></div><div class="now-grid"><div><span>BUILDING</span><strong>NoteX</strong></div><div><span>EXPLORING</span><p>AI product<br />Agent systems<br />Frontend architecture<br />Desktop / browser platforms</p></div><div><span>LEARNING</span><p>Pattern recognition<br />Advanced algorithms</p></div><div><span>WRITING ABOUT</span><p>AI UX<br />Loading architecture<br />React server boundaries</p></div></div></Container></section>

  <section class="education-section" aria-labelledby="education-title"><Container><div class="section-label"><span id="education-title">EDUCATION</span><small>RECORD / 06</small></div><div class="education-record"><div><strong>[UNIVERSITY / TBD]</strong><span>[PROGRAM / TBD]</span></div><div><span>[YEAR / TBD]</span><p>Selected focus<br />Advanced algorithms<br />Software systems<br />AI</p></div></div></Container></section>

  <section class="projects-section" aria-labelledby="projects-title"><Container><div class="section-label"><span id="projects-title">PROJECTS / LAB</span><small>ARCHIVE / 07</small></div><div class="project-registry">{projects.map(([index,title,category,status,href])=><a class="registry-row" href={href}><span>{index}</span><strong>{title}</strong><span>{category}</span><span>{status}</span><span aria-hidden="true">↗</span></a>)}</div></Container></section>

  <section class="system-map-section" aria-labelledby="map-title"><Container><div class="section-label"><span id="map-title">PERSONAL SYSTEM MAP</span><small>POSITIONING / 08</small></div><div class="system-map" role="img" aria-label="Son Nguyen works between product, design, engineering, and AI, with strongest edge in frontend architecture"><div class="map-axis map-axis-vertical"></div><div class="map-axis map-axis-horizontal"></div><span class="map-point map-product">PRODUCT</span><span class="map-point map-design">DESIGN</span><span class="map-point map-engineering">ENGINEERING</span><span class="map-point map-ai">AI</span><strong class="map-you">YOU</strong><small class="map-annotation">strongest edge →<br /><b>frontend architecture</b></small></div></Container></section>

  <section class="contact-section" aria-labelledby="contact-title"><Container><div class="section-label"><span id="contact-title">CONTACT / SOCIAL</span><small>OPEN CHANNEL / 09</small></div><dl class="contact-list"><div><dt>Email</dt><dd>[EMAIL TBD]</dd></div><div><dt>GitHub</dt><dd>[GITHUB TBD]</dd></div><div><dt>LinkedIn</dt><dd>[LINKEDIN TBD]</dd></div></dl></Container></section>

  <section class="about-closing" aria-labelledby="closing-title"><Container><p class="section-label">CLOSING / 10</p><h2 id="closing-title">The work<br />explains<br />the rest.</h2><p>See how these ideas become products.</p><Link href="/work" variant="arrow">View selected work</Link></Container></section>
</BaseLayout>
<style>
  .dossier-hero,.quick-info,.about-introduction,.capability-section,.experience-section,.now-section,.education-section,.projects-section,.system-map-section,.contact-section,.about-closing { border-top:1px solid var(--color-border); }
  .dossier-hero { padding-block:1.5rem clamp(7rem,14vw,13rem); }.dossier-topline,.dossier-label,.section-label,.hero-role,.profile-mark span,.profile-mark small,.quick-info dt,.capability-row > span,.record-company,.record-period,.now-grid span,.education-record span,.project-registry > *,.contact-list dt { color:var(--color-muted); font:500 var(--type-meta)/1.2 var(--font-mono); letter-spacing:.1em; text-transform:uppercase; }.dossier-topline { display:flex; justify-content:space-between; }.dossier-hero-grid { display:grid; grid-template-columns:7fr 5fr; gap:var(--grid-gap); margin-top:clamp(7rem,14vw,13rem); }.dossier-hero h1 { margin-top:1rem; font:560 var(--type-display-xxl)/.82 var(--font-sans); letter-spacing:-.045em; }.hero-role { margin-top:3rem; line-height:1.7; color:var(--color-text); }.profile-mark { align-self:end; min-height:20rem; display:grid; align-content:space-between; padding:1rem; border:1px solid var(--color-border); }.profile-mark strong { font:400 var(--type-display-md)/.95 var(--font-serif); letter-spacing:-.025em; }.profile-mark small { color:var(--color-accent); }
  .section-label { display:flex; justify-content:space-between; gap:2rem; padding-block:1rem; }.section-label small { color:var(--color-muted); font:inherit; }.quick-info { padding-block:0 clamp(6rem,10vw,10rem); }.quick-info dl { display:grid; grid-template-columns:repeat(3,1fr); margin:4rem 0 0; border-top:1px solid var(--color-border); }.quick-info dl div { min-height:8rem; display:grid; align-content:space-between; gap:1rem; padding:1rem 1.5rem 1.5rem 0; border-bottom:1px solid var(--color-border); }.quick-info dd { margin:0; font-size:1.15rem; }.quick-info dt { font:inherit; }
  .about-introduction,.capability-section,.experience-section,.now-section,.education-section,.projects-section,.system-map-section,.contact-section { padding-block:clamp(6rem,10vw,10rem); }.intro-grid { display:grid; grid-template-columns:5fr 5fr; gap:12%; margin-top:5rem; }.caveat { color:var(--color-accent); font:400 1rem var(--font-handwritten); }.intro-grid h2 { max-width:14ch; margin-top:2rem; font:560 var(--type-heading)/.98 var(--font-sans); letter-spacing:-.035em; }.intro-serif { font:400 var(--type-display-md)/1.02 var(--font-serif); letter-spacing:-.025em; }.intro-body { max-width:42rem; margin-top:2rem; color:var(--color-muted); font-size:var(--type-body); text-wrap:pretty; }
  .capability-list { margin-top:4rem; border-top:1px solid var(--color-border); }.capability-row { display:grid; grid-template-columns:4rem 3fr 7fr; gap:var(--grid-gap); align-items:baseline; padding-block:1.25rem; border-bottom:1px solid var(--color-border); }.capability-row strong { font-size:clamp(1.25rem,2.2vw,2rem); text-transform:uppercase; }.capability-row p { margin:0; color:var(--color-muted); font-size:var(--type-body); }.verification-note { margin-top:1.5rem; color:var(--color-accent); font:var(--type-meta) var(--font-mono); }
  .experience-record { display:grid; grid-template-columns:4rem 4fr 5fr; gap:var(--grid-gap); margin-top:4rem; padding-top:1.5rem; border-top:1px solid var(--color-border); }.record-index { color:var(--color-accent); font:var(--type-meta) var(--font-mono); }.experience-record h2 { margin-top:1.25rem; font:550 var(--type-display-md)/.95 var(--font-sans); letter-spacing:-.04em; text-transform:uppercase; }.record-period { margin-top:1.5rem; }.experience-record ul { margin:0; padding:0; list-style:none; }.experience-record li { padding-block:.75rem; border-bottom:1px solid var(--color-border); color:var(--color-muted); }.experience-record li::before { content:'— '; color:var(--color-accent); }
  .now-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:var(--grid-gap); margin-top:4rem; }.now-grid > div { min-height:14rem; display:grid; align-content:space-between; padding:1rem 1rem 1rem 0; border-top:1px solid var(--color-border); }.now-grid strong { font-size:clamp(1.5rem,3vw,3rem); text-transform:uppercase; }.now-grid p { margin:0; color:var(--color-muted); line-height:1.7; }
  .education-record { display:grid; grid-template-columns:1fr 1fr; gap:var(--grid-gap); margin-top:4rem; padding-top:1.5rem; border-top:1px solid var(--color-border); }.education-record > div { display:grid; gap:1rem; }.education-record strong { font-size:1.5rem; }.education-record p { margin:0; color:var(--color-muted); line-height:1.7; }
  .project-registry { margin-top:4rem; border-top:1px solid var(--color-border); }.registry-row { display:grid; grid-template-columns:4rem 5fr 2fr 2fr 1rem; gap:var(--grid-gap); align-items:baseline; padding-block:1.25rem; border-bottom:1px solid var(--color-border); }.registry-row strong { font-size:clamp(1.25rem,2.4vw,2.25rem); text-transform:uppercase; }.registry-row:hover strong { color:var(--color-accent); }
  .system-map { position:relative; min-height:34rem; max-width:64rem; margin:4rem auto 0; display:grid; place-items:center; }.map-axis { position:absolute; background:var(--color-border); }.map-axis-horizontal { width:100%; height:1px; }.map-axis-vertical { width:1px; height:100%; }.map-point,.map-you,.map-annotation { position:absolute; font:500 var(--type-meta) var(--font-mono); letter-spacing:.1em; text-transform:uppercase; }.map-product { top:8%; }.map-ai { bottom:8%; }.map-design { left:0; }.map-engineering { right:0; }.map-you { z-index:1; display:grid; place-items:center; width:6rem; height:6rem; border:1px solid var(--color-accent); background:var(--color-bg); color:var(--color-accent); border-radius:50%; }.map-annotation { right:9%; bottom:24%; color:var(--color-accent); line-height:1.7; }.map-annotation b { color:var(--color-text); font-weight:500; }
  .contact-list { display:grid; grid-template-columns:repeat(3,1fr); margin-top:4rem; }.contact-list div { display:grid; gap:2rem; padding:1rem 1.5rem 1rem 0; border-top:1px solid var(--color-border); }.contact-list dd { margin:0; font-size:1.1rem; }.about-closing { padding-block:clamp(8rem,17vw,16rem); }.about-closing h2 { margin-top:4rem; font:560 var(--type-display-xl)/.82 var(--font-sans); letter-spacing:-.06em; text-transform:uppercase; }.about-closing > :global(.container) > p:not(.section-label) { margin:3rem 0 1.5rem; color:var(--color-muted); font:400 var(--type-lead) var(--font-serif); }.about-closing :global(.link) { border-bottom:1px solid currentColor; padding-bottom:.35rem; font-weight:600; }
  @media (max-width:640px) { .dossier-topline { font-size:.62rem; }.dossier-hero-grid,.intro-grid { display:block; }.dossier-hero h1 { font-size:clamp(4.5rem,20vw,7rem); }.profile-mark { min-height:16rem; margin-top:5rem; }.quick-info dl,.contact-list { grid-template-columns:1fr 1fr; }.quick-info dl div { min-height:7rem; }.intro-grid > div + div { margin-top:4rem; }.intro-serif { font-size:2.5rem; }.capability-row { grid-template-columns:2.5rem 1fr; }.capability-row p { grid-column:2; }.experience-record { grid-template-columns:2.5rem 1fr; }.experience-record ul { grid-column:2; margin-top:1rem; }.now-grid { grid-template-columns:1fr 1fr; }.now-grid > div { min-height:10rem; }.education-record { grid-template-columns:1fr 1fr; }.registry-row { grid-template-columns:2.5rem 1fr 1rem; }.registry-row > span:nth-of-type(2),.registry-row > span:nth-of-type(3) { grid-column:2; }.system-map { min-height:24rem; }.map-point { font-size:.6rem; }.map-annotation { right:0; bottom:20%; font-size:.6rem; }.about-closing h2 { font-size:clamp(4rem,18vw,6rem); } }
</style>
