---
import Container from './primitives/Container.astro';
import { siteConfig } from '../data/site';
import SocialLinks from './navigation/SocialLinks.astro';
---
<footer class="site-footer"><Container><div class="footer-identity"><a href="/">{siteConfig.name}</a><p>Product Engineer<br />Thoughtful products. Considered systems.</p></div><nav aria-label="Footer navigation"><a href="/work">Work</a><a href="/components">Components</a><a href="/about">About</a><a href="/notes">Notes</a><a href="/playground">Playground</a></nav><SocialLinks github={siteConfig.github} linkedin={siteConfig.linkedin} email={siteConfig.email} /><div class="footer-meta"><span>Vietnam / English edition</span><span>© {new Date().getFullYear()} {siteConfig.name}</span><a href="#main">Back to top</a></div></Container></footer>
<style>
  .site-footer { padding-block:3rem 1.5rem; }
  .site-footer :global(.container) { display:grid; grid-template-columns:1fr 1fr; column-gap:3rem; }
  .footer-identity > a { display:inline-flex; min-height:2.75rem; align-items:center; color:var(--text); font-size:1.25rem; letter-spacing:-.03em; font-weight:500; }
  .footer-identity p { margin-top:.5rem; font-size:.8125rem; line-height:1.75rem; }
  .site-footer nav { justify-self:end; flex-wrap:wrap; align-content:start; gap:0 1.5rem; max-width:26rem; }
  .site-footer nav a { display:inline-flex; align-items:center; min-height:2.75rem; font-size:.8125rem; }
  .site-footer :global(.social-links) { grid-column:2; }
  .footer-meta { grid-column:1 / -1; flex-wrap:wrap; align-items:center; gap:1rem; margin-top:3rem; padding-top:1rem; border-top:1px solid var(--border); font-size:.625rem; }
  .footer-meta a { display:inline-flex; align-items:center; min-height:2.75rem; }
  @media (max-width:640px) { .site-footer :global(.container) { grid-template-columns:1fr; }.site-footer nav,.site-footer :global(.social-links) { grid-column:1; justify-self:start; margin-top:1rem; }.footer-meta { margin-top:2rem; }.footer-meta > span:first-child { width:100%; } }
</style>
