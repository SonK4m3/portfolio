---
import Container from './primitives/Container.astro'; import { siteConfig } from '../data/site'; import SocialLinks from './navigation/SocialLinks.astro';
---
<footer class="site-footer"><Container><p>Let's build something useful.</p><SocialLinks github={siteConfig.github} linkedin={siteConfig.linkedin} email={siteConfig.email} /><div class="footer-meta"><span>© {new Date().getFullYear()}</span></div></Container></footer>
