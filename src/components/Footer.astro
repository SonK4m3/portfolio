---
import Container from './primitives/Container.astro'; import { siteConfig } from '../data/site'; import SocialLinks from './navigation/SocialLinks.astro';
---
<footer class="site-footer"><Container><div><strong>{siteConfig.name}</strong><p>Product Engineer<br />AI product / Frontend architecture</p></div><nav aria-label="Footer navigation"><a href="/work">Work</a><a href="/about">About</a><a href="/notes">Notes</a><a href="/playground">Playground</a></nav><SocialLinks github={siteConfig.github} linkedin={siteConfig.linkedin} email={siteConfig.email} /><div class="footer-meta"><span aria-label="English selected; Vietnamese localization is planned">EN / VI</span><span>© {new Date().getFullYear()}</span></div></Container></footer>
<style>
  .site-footer :global(.container) { display:grid; grid-template-columns:2fr 1fr; gap:3rem; }.site-footer p { margin-top:.75rem; font:600 .72rem/1.6 var(--font-mono); text-transform:uppercase; }.site-footer nav { display:grid; justify-items:start; gap:.6rem; }.site-footer :global(.social-links) { grid-column:2; }.footer-meta { grid-column:1 / -1; }
  @media (max-width:640px) { .site-footer :global(.container) { grid-template-columns:1fr; }.site-footer nav,.site-footer :global(.social-links) { grid-column:1; }.footer-meta { gap:2rem; } }
</style>
