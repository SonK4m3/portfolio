---
import Container from './primitives/Container.astro'; import { siteConfig } from '../data/site'; import { navigation } from '../data/navigation'; import NavLink from './navigation/NavLink.astro'; import ThemeControls from './navigation/ThemeControls.astro';
---
<header class="site-header"><Container><a class="brand" href="/">{siteConfig.name}<span class="brand-mark" aria-hidden="true">*</span></a><nav aria-label="Primary navigation">{navigation.map((item) => <NavLink href={item.href} label={item.label} />)}</nav><ThemeControls /></Container></header>
<style>.brand-mark { color:var(--accent); font-size:1.6em; font-weight:400; margin-left:.15rem; line-height:1; align-self:center; padding-top:.35rem; }</style>
