---
export interface Props { className?: string; id?: string; label?: string }
const { className = '', id, label } = Astro.props as Props;
---
<div id={id} class:list={['hatch-divider', className]} aria-label={label}>
  {label && <span>{label}</span>}
</div>
<style>
  .hatch-divider { min-height:1rem; border-block:1px solid var(--color-border); background:repeating-linear-gradient(135deg,transparent 0,transparent 5px,var(--color-border) 5px,var(--color-border) 6px); }
  span { display:inline-block; margin-left:var(--space-4); padding-inline:var(--space-2); background:var(--color-background); color:var(--color-muted); font:500 var(--type-meta)/1rem var(--font-mono); letter-spacing:.1em; text-transform:uppercase; }
</style>
