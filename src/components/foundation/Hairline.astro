---
export interface Props { className?: string; id?: string; vertical?: boolean }
const { className = '', id, vertical = false } = Astro.props as Props;
---
<span id={id} class:list={['hairline', { vertical }, className]} aria-hidden="true"></span>
<style>
  .hairline { display:block; width:100%; height:1px; background:var(--color-border); }
  .hairline.vertical { width:1px; height:100%; }
</style>
