---
import Hairline from './Hairline.astro';
export interface Props { className?: string; id?: string; label: string; index?: string }
const { className = '', id, label, index } = Astro.props as Props;
---
<div id={id} class:list={['technical-divider', className]}>
  <span>{label}{index && ` / ${index}`}</span>
  <Hairline />
</div>
<style>
  .technical-divider { display:grid; grid-template-columns:minmax(0,max-content) minmax(0,1fr); gap:var(--space-4); align-items:center; color:var(--color-muted); font:500 var(--type-meta)/1 var(--font-mono); letter-spacing:.1em; text-transform:uppercase; }
  .technical-divider > span { min-width:0; overflow-wrap:anywhere; }
  @media (max-width:640px) { .technical-divider { grid-template-columns:minmax(0,1fr); gap:var(--space-3); } }
</style>
