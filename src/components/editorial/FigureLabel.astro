---
export type FigureType = 'FIG' | 'SYS' | 'CMP' | 'EXP' | 'BLK';
export interface Props { className?: string; id?: string; index: string; type?: FigureType; title: string; description?: string; position?: 'top' | 'bottom'; signal?: string; as?: 'figcaption' | 'div' }
const { className = '', id, index, type = 'FIG', title, description, position = 'top', signal, as = 'figcaption' } = Astro.props as Props;
const spoken = [`${type}. ${index}`, title, description].filter(Boolean).join(', ');
const Tag = as === 'div' ? 'div' : 'figcaption';
---
<Tag id={id} class:list={['figure-label', `position-${position}`, className]} aria-label={spoken}>
  <span aria-hidden="true">{type}. {index} / {title}{description && ` / ${description}`}</span>
  {signal && <small>{signal}</small>}
</Tag>
<style>
  .figure-label { display:flex; justify-content:space-between; gap:var(--space-4); color:var(--color-muted); font:500 var(--type-meta)/1.3 var(--font-mono); letter-spacing:.1em; text-transform:uppercase; }
  .position-top { margin-bottom:var(--space-5); }.position-bottom { margin-top:var(--space-4); }
  small { color:var(--color-signal); font:inherit; }
  @media (max-width:640px) { .figure-label { display:grid; } }
</style>
