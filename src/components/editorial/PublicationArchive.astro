---
import Arrow from './Arrow.astro';
interface Props {
  title: string;
  description: string;
  emptyTitle: string;
  emptyDescription: string;
  entries: { title: string; description: string; href: string }[];
  topics: string[];
}
const { title, description, emptyTitle, emptyDescription, entries, topics } = Astro.props;
---
<section class="publication-archive container">
  <header><h1>{title}<span>.</span></h1><p>{description}</p></header>
  {entries.length ? <div class="archive-list">{entries.map(entry => <article><h2><a href={entry.href}>{entry.title}<Arrow /></a></h2><p>{entry.description}</p></article>)}</div> : <div class="archive-waiting"><div><h2>{emptyTitle}</h2><p>{emptyDescription}</p><a href="/work/notex">Read the NoteX case study <Arrow direction="right" /></a></div><aside aria-label="Areas of interest"><span>Areas of interest</span><ul>{topics.map(topic => <li>{topic}</li>)}</ul></aside></div>}
  <div class="archive-foot"><span>From the practice of building products.</span><a href="/components">Explore the component laboratory <Arrow /></a></div>
</section>
<style>
  .publication-archive { padding-block:4rem 5rem; min-height:calc(100svh - 5rem); }
  header { display:grid; grid-template-columns:7fr 4fr; gap:8%; align-items:end; padding-bottom:4rem; }
  h1 { font-size:clamp(3.5rem,8vw,6rem); font-weight:500; letter-spacing:-.04em; line-height:1; overflow-wrap:anywhere; } h1 > span { color:var(--accent); }
  header > p { max-width:30ch; font-size:clamp(1.2rem,2vw,1.75rem); line-height:1.4; letter-spacing:-.02em; text-wrap:pretty; }
  .archive-waiting { display:grid; grid-template-columns:7fr 4fr; gap:8%; border-top:1px solid var(--text); padding-block:4rem; }
  .archive-waiting h2 { font-size:clamp(1.75rem,3vw,2.75rem); line-height:1.15; font-weight:450; max-width:18ch; }
  .archive-waiting p { max-width:44ch; color:var(--muted); font-size:.9375rem; line-height:1.75; margin-top:1.5rem; }
  .archive-waiting a { width:fit-content; margin-top:2rem; }
  a { display:flex; align-items:center; justify-content:space-between; gap:1rem; min-height:2.75rem; font-size:.8125rem; border-bottom:1px solid currentColor; }
  aside > span { font:400 .6875rem var(--font-mono); color:var(--muted); }
  ul { margin:1rem 0 0; padding:0; list-style:none; } li { padding-block:1rem; border-bottom:1px solid var(--border); font-size:1.1rem; letter-spacing:-.02em; }
  .archive-foot { display:flex; justify-content:space-between; align-items:center; gap:2rem; border-top:1px solid var(--border); padding-top:1.5rem; margin-top:2rem; }.archive-foot > span { font-size:.75rem; color:var(--muted); }
  .archive-list { border-top:1px solid var(--text); }.archive-list article { padding-block:2rem; border-bottom:1px solid var(--border); }.archive-list h2 a { font-size:1.75rem; width:fit-content; }.archive-list p { max-width:60ch; margin-top:1rem; color:var(--muted); }
  @media (max-width:700px) { .publication-archive { padding-block:3rem 4rem; } header,.archive-waiting { grid-template-columns:minmax(0,1fr); gap:2rem; } header { padding-bottom:2.5rem; } h1 { font-size:clamp(2.7rem,11vw,4.5rem); } header > p { max-width:27ch; font-size:1.2rem; }.archive-waiting { padding-block:2.5rem; gap:3rem; }.archive-foot { display:block; }.archive-foot a { margin-top:1rem; width:fit-content; } }
</style>
