---
import Container from '../primitives/Container.astro';
const principles = [
  { title:'Start with the real problem.', note:'Before a transition gets another loader, I ask which layer owns it and what the user is actually waiting for.', tag:'NOTE.01 / PRODUCT FLOW' },
  { title:'Design the boundaries.', note:'Server state, local state, realtime events, and persisted browser data should not share one ownership model.', tag:'DECISION.02 / STATE' },
  { title:'Ship it, then learn.', note:'A technical choice becomes a product decision only after it meets users, latency, failures, and production.', tag:'NOTE.03 / PRODUCTION' },
];
---
<section class="how-i-build density-quiet" aria-labelledby="build-title" data-density="quiet"><Container><p class="build-kicker">HOW I BUILD / THREE WORKING RULES</p><h2 id="build-title">The principles only matter when they change a decision.</h2><ol>{principles.map((item,index)=><li><span>{String(index+1).padStart(2,'0')}</span><h3>{item.title}</h3><div><small>{item.tag}</small><p>{item.note}</p></div></li>)}</ol></Container></section>
<style>
  .how-i-build { min-height:120svh; border-top:1px solid var(--color-border); }.build-kicker,.how-i-build ol > li > span,.how-i-build small { color:var(--color-muted); font:500 var(--type-meta) var(--font-mono); letter-spacing:.1em; text-transform:uppercase; }.how-i-build > :global(.container) > h2 { max-width:17ch; margin-top:3rem; font:400 var(--type-heading)/1.08 var(--font-serif); letter-spacing:-.02em; text-wrap:balance; }.how-i-build ol { margin:9rem 0 0; padding:0; list-style:none; }.how-i-build li { display:grid; grid-template-columns:4rem repeat(11,1fr); gap:var(--grid-gap); min-height:28rem; padding-block:2rem; }.how-i-build li > span { grid-column:1; }.how-i-build h3 { grid-column:2 / span 6; max-width:12ch; font-size:clamp(2.5rem,5vw,5rem); line-height:.92; letter-spacing:-.04em; text-transform:uppercase; text-wrap:balance; }.how-i-build li > div { grid-column:9 / span 4; align-self:end; }.how-i-build li > div p { margin-top:1rem; color:var(--color-muted); font-size:var(--type-body); text-wrap:pretty; }.how-i-build li:nth-child(2) { margin-top:5rem; }.how-i-build li:nth-child(2) h3 { grid-column:6 / span 6; }.how-i-build li:nth-child(2) > div { grid-column:2 / span 4; grid-row:1; align-self:end; }.how-i-build li:nth-child(3) h3 { grid-column:2 / span 5; }.how-i-build li:nth-child(3) > div { grid-column:8 / span 4; }
  @media (max-width:640px) { .how-i-build { min-height:auto; }.how-i-build ol { margin-top:6rem; }.how-i-build li { display:grid; grid-template-columns:2.5rem 1fr; min-height:auto; padding-block:3rem; }.how-i-build li > span { grid-column:1; }.how-i-build h3,.how-i-build li:nth-child(2) h3,.how-i-build li:nth-child(3) h3 { grid-column:2; }.how-i-build li:nth-child(2) { margin-top:0; }.how-i-build li > div,.how-i-build li:nth-child(2) > div,.how-i-build li:nth-child(3) > div { grid-column:2; grid-row:auto; margin-top:2rem; } }
</style>
