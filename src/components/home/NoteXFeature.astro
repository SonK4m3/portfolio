---
import Container from '../primitives/Container.astro';
import Link from '../typography/Link.astro';
import FigureLabel from '../editorial/FigureLabel.astro';
import DossierMatrix from '../system/DossierMatrix.astro';
interface Props { productImage?: string; productImageAlt?: string }
const { productImage, productImageAlt = 'NoteX product interface' } = Astro.props as Props;
---
<section class="notex-feature density-evidence" id="work" aria-labelledby="notex-title" data-density="evidence">
  <Container>
    <p class="notex-eyebrow">Selected work / 01</p>
    <h2 id="notex-title">NoteX</h2>
    <div class="notex-intro"><p class="notex-thesis">AI products for how people learn, capture knowledge, and work.</p><div class="notex-copy"><p>A production AI product for learning, notes, and meetings — built across B2C and B2B contexts.</p><p>I lead frontend engineering and work across product, UI/UX, architecture, and platform evolution.</p></div></div>
    {productImage ? <figure class="notex-visual media-fill"><img src={productImage} alt={productImageAlt} loading="lazy" /><FigureLabel index="01" title="NOTEX" description="PRODUCTION PRODUCT" position="bottom" /></figure> : <div class="notex-evidence media-fill" data-product-evidence><FigureLabel as="div" className="evidence-index" index="01" title="NOTEX" description="PRODUCT UI" signal="ASSET REQUIRED" /><strong>Product evidence<br />belongs here.</strong><p>One production NoteX screen at full visual weight. No device frame, no reconstruction, no invented UI.</p><small>[ASSET REQUIRED]</small></div>}
    <div class="notex-context"><DossierMatrix className="notex-meta" items={[{ label:'Role', value:'Product Engineer / Frontend Lead' },{ label:'Scope', value:'Product flow / Architecture / AI UX' }]} columns={2} /><div class="notex-footer"><div class="notex-disciplines" aria-hidden="true"><span>Production AI</span><span class="architecture-cue">State ownership</span><span>Platform evolution</span></div><Link href="/work/notex" variant="arrow">View case study</Link></div></div>
  </Container>
</section>
<style>
  .notex-feature { position:relative; border-top:1px solid var(--color-border); background-image:linear-gradient(to right,color-mix(in srgb,var(--color-border) 35%,transparent) 1px,transparent 1px); background-size:calc((100% - (var(--page-gutter) * 2)) / 12) 100%; background-position:var(--page-gutter) 0; }
  .notex-eyebrow,.notex-meta span,.notex-disciplines,.notex-visual figcaption,.evidence-index,.notex-evidence small { color:var(--color-muted); font:500 var(--type-meta) var(--font-mono); letter-spacing:.1em; text-transform:uppercase; }
  h2 { margin-top:clamp(2rem,5vw,5rem); font:560 var(--type-display-xl)/.91 var(--font-sans); letter-spacing:-.04em; }
  .notex-intro { display:grid; grid-template-columns:repeat(12,1fr); gap:var(--grid-gap); margin-top:clamp(5rem,10vw,10rem); }.notex-thesis { grid-column:1 / span 6; max-width:16ch; font:550 var(--type-display-md)/.96 var(--font-sans); letter-spacing:-.04em; text-wrap:balance; }.notex-copy { grid-column:8 / span 5; display:grid; gap:1.25rem; align-self:end; color:var(--color-muted); font-size:var(--type-body); }.notex-copy p { text-wrap:pretty; }
  .notex-visual,.notex-evidence { margin:clamp(5rem,9vw,9rem) 0 0 max(-3vw,-3rem); }.notex-visual img { display:block; width:100%; max-height:88svh; object-fit:cover; object-position:center top; outline:1px solid color-mix(in srgb,var(--color-text) 12%,transparent); outline-offset:-1px; }.notex-visual figcaption { margin-top:1rem; }
  .notex-evidence { position:relative; min-height:min(58vw,52rem); display:grid; align-content:center; justify-items:center; gap:1.5rem; border:1px solid var(--color-line); background:var(--color-surface); text-align:center; }.evidence-index { position:absolute; inset:1rem 1rem auto; display:grid; grid-template-columns:5rem 1fr auto; gap:var(--grid-gap); width:calc(100% - 2rem); text-align:left; }.notex-evidence strong { max-width:12ch; font:550 var(--type-display-md)/.9 var(--font-sans); letter-spacing:-.04em; text-wrap:balance; }.notex-evidence p { max-width:34rem; color:var(--color-muted); font-size:var(--type-body); text-wrap:pretty; }.notex-evidence small { color:var(--color-accent); }
  .notex-context { display:grid; grid-template-columns:repeat(12,1fr); gap:var(--grid-gap); margin-top:clamp(4rem,7vw,7rem); }.notex-meta { grid-column:1 / span 5; display:grid; grid-template-columns:repeat(2,1fr); gap:2rem; }.notex-meta div { display:grid; gap:.75rem; }.notex-meta strong { font-size:.85rem; line-height:1.6; text-transform:uppercase; }.notex-footer { grid-column:7 / -1; display:flex; justify-content:space-between; align-items:end; gap:2rem; padding-top:1.5rem; border-top:1px solid var(--color-border); }.notex-disciplines { display:flex; flex-wrap:wrap; gap:1.5rem; }.architecture-cue { color:var(--color-text); }
  @media (max-width:640px) { .notex-feature { background-size:25% 100%; } h2 { font-size:clamp(5rem,27vw,8rem); }.notex-intro { display:block; margin-top:5rem; }.notex-thesis { max-width:12ch; }.notex-copy { margin-top:4rem; }.notex-visual,.notex-evidence { width:100%; margin-left:0; }.notex-evidence { min-height:28rem; padding:6rem 1.25rem 2rem; }.evidence-index { grid-template-columns:1fr auto; }.evidence-index span:nth-child(2) { display:none; }.notex-context { display:block; }.notex-meta { grid-template-columns:1fr 1fr; margin-top:4rem; }.notex-footer { align-items:start; flex-direction:column; margin-top:4rem; }.notex-disciplines { flex-direction:column; gap:.75rem; } }
  .notex-context :global(.notex-meta) { grid-column:1 / span 5; }
  .notex-evidence :global(.evidence-index) { position:absolute; inset:1rem 1rem auto; width:calc(100% - 2rem); }
</style>
