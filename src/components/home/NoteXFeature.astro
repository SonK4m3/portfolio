---
import Container from '../primitives/Container.astro';
import Link from '../typography/Link.astro';

interface Props { productImage?: string; productImageAlt?: string }
const { productImage, productImageAlt = 'NoteX product interface' } = Astro.props as Props;
---
<section class="notex-feature" id="work" aria-labelledby="notex-title">
  <Container>
    <p class="notex-eyebrow">Selected work / 01</p>
    <h2 id="notex-title">NoteX</h2>
    <div class="notex-intro">
      <p class="notex-thesis">AI products for how people learn, capture knowledge, and work.</p>
      <div class="notex-copy">
        <p>NoteX is a production AI product serving students and professionals across learning, note-taking, and meeting workflows.</p>
        <p>I work across product engineering, UI/UX, frontend architecture, feature development, and the systems that allow the product to evolve across platforms and use cases.</p>
      </div>
    </div>
    {productImage ? <figure class="notex-visual"><img src={productImage} alt={productImageAlt} loading="lazy" /><figcaption>Fig. 01 — NoteX / Production product</figcaption></figure> : <div class="notex-evidence" data-product-evidence><span>FIG. 01 / NOTEX-HERO</span><strong>Real product evidence goes here.</strong><p>Add a high-resolution NoteX production surface before publishing. The layout is reserved at full visual weight so the screenshot can lead the section.</p><small>[ASSET REQUIRED]</small></div>}
    <div class="notex-context"><div class="notex-meta" aria-label="Project role and disciplines"><div><span>Role</span><strong>Product Engineer<br />Frontend Lead</strong></div><div><span>Disciplines</span><strong>Product<br />Frontend Architecture<br />AI UX</strong></div></div><div class="notex-footer"><div class="notex-disciplines" aria-hidden="true"><span>Product engineering</span><span class="architecture-cue">Frontend architecture</span><span>AI UX</span></div><Link href="/work/notex" variant="arrow">View case study</Link></div></div>
  </Container>
</section>
<style>
  .notex-feature { position:relative; padding-block:clamp(6rem,12vw,11rem); border-top:1px solid var(--color-border); background-image:linear-gradient(to right,color-mix(in srgb,var(--color-border) 35%,transparent) 1px,transparent 1px); background-size:calc((100% - (var(--page-gutter) * 2)) / 12) 100%; background-position:var(--page-gutter) 0; }
  .notex-eyebrow,.notex-meta span,.notex-disciplines,.notex-visual figcaption,.notex-evidence > span,.notex-evidence small { color:var(--color-muted); font:500 var(--type-meta) var(--font-mono); letter-spacing:.1em; text-transform:uppercase; }
  h2 { margin-top:clamp(2rem,5vw,5rem); font:560 var(--type-display-xl)/.91 var(--font-sans); letter-spacing:-.045em; }
  .notex-intro { display:grid; grid-template-columns:repeat(12,1fr); gap:var(--grid-gap); margin-top:clamp(5rem,10vw,10rem); }.notex-thesis { grid-column:1 / span 6; max-width:16ch; font:550 var(--type-display-md)/.96 var(--font-sans); letter-spacing:-.04em; }.notex-copy { grid-column:8 / span 5; display:grid; gap:1.25rem; align-self:end; color:var(--color-muted); font-size:var(--type-body); }
  .notex-visual,.notex-evidence { margin:clamp(5rem,9vw,9rem) 0 0; }.notex-visual img { display:block; width:100%; height:auto; }.notex-visual figcaption { margin-top:1rem; }
  .notex-evidence { min-height:min(58vw,52rem); display:grid; align-content:center; justify-items:center; gap:1.5rem; border:1px solid var(--color-line); background:var(--color-surface); text-align:center; }.notex-evidence strong { max-width:12ch; font:550 var(--type-display-md)/.9 var(--font-sans); letter-spacing:-.04em; }.notex-evidence p { max-width:34rem; color:var(--color-muted); font-size:var(--type-body); }.notex-evidence small { color:var(--color-accent); }
  .notex-context { display:grid; grid-template-columns:repeat(12,1fr); gap:var(--grid-gap); margin-top:clamp(4rem,7vw,7rem); }.notex-meta { grid-column:1 / span 5; display:grid; grid-template-columns:repeat(2,1fr); gap:2rem; }.notex-meta div { display:grid; gap:.75rem; }.notex-meta strong { font-size:.85rem; line-height:1.6; text-transform:uppercase; }
  .notex-footer { grid-column:7 / -1; display:flex; justify-content:space-between; align-items:end; gap:2rem; padding-top:1.5rem; border-top:1px solid var(--color-border); }.notex-disciplines { display:flex; flex-wrap:wrap; gap:1.5rem; }.architecture-cue { color:var(--color-text); }
  @media (max-width:640px) { .notex-feature { background-size:25% 100%; } h2 { font-size:clamp(5rem,27vw,8rem); }.notex-intro { display:block; margin-top:5rem; }.notex-thesis { max-width:12ch; }.notex-copy { margin-top:4rem; }.notex-evidence { min-height:28rem; padding:2rem 1.25rem; }.notex-context { display:block; }.notex-meta { grid-template-columns:1fr 1fr; margin-top:4rem; }.notex-footer { align-items:start; flex-direction:column; margin-top:4rem; }.notex-disciplines { flex-direction:column; gap:.75rem; } }
</style>
