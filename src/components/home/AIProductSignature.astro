---
import Container from '../primitives/Container.astro';
import Link from '../typography/Link.astro';
import FigureLabel from '../editorial/FigureLabel.astro';
import LifecycleFlow from '../system/LifecycleFlow.astro';
const trace = [
  { id:'start', meta:'00:00', label:'User starts generation' },
  { id:'task', meta:'00:01', label:'Task created' },
  { id:'run', meta:'00:04', label:'Generation continues' },
  { id:'leave', meta:'00:06', label:'User leaves the note' },
  { id:'event', meta:'00:12', label:'SSE update arrives' },
  { id:'persist', meta:'00:14', label:'Task state persists' },
  { id:'return', meta:'00:20', label:'User returns' },
  { id:'result', meta:'00:21', label:'Result attaches to note' },
];
const questions = ['Can the user leave?','What owns the task while they are gone?','What happens when they return?'];
---
<section class="ai-product density-technical" aria-labelledby="ai-product-title" data-density="technical">
  <Container>
    <FigureLabel as="div" type="SYS" index="03" title="AI TASK LIFECYCLE" description="LONG-RUNNING GENERATION" signal="VERIFY FLOW" />
    <div class="ai-intro"><h2 id="ai-product-title">Generation is easy.<br />Reliability is<br />the product.</h2><div><p>A NoteX generation task can outlive the screen that started it. The product has to preserve the task, receive the update, and put the result back where the user expects it.</p><small>[FLOW TO VERIFY AGAINST PRODUCTION]</small></div></div>
    <div class="ai-field">
      <LifecycleFlow className="task-trace" steps={trace} active="event" figureIndex="03" title="EVENT TRACE" signalLabel="REALTIME EVENT" />
      <div class="ai-questions"><p>Product questions</p><ul>{questions.map(question=><li>{question}</li>)}</ul></div>
    </div>
    <blockquote>The model can finish later.<br />The product still has to remember.</blockquote>
    <Link href="/work/notex#making-ai-feel-like-product" variant="arrow">Explore AI inside NoteX</Link>
  </Container>
</section>
<style>
  .ai-product { min-height:165svh; border-top:1px solid var(--color-border); }
  .ai-intro { display:grid; grid-template-columns:repeat(12,1fr); gap:var(--grid-gap); margin-top:3rem; }
  .ai-intro h2 { grid-column:1 / span 8; font:560 var(--type-display-xl)/.91 var(--font-sans); letter-spacing:-.04em; text-transform:uppercase; text-wrap:balance; }
  .ai-intro > div { grid-column:9 / span 4; align-self:end; display:grid; gap:1.2rem; color:var(--color-muted); font-size:var(--type-body); }
  .ai-intro small,.ai-questions > p { color:var(--color-muted); font:500 var(--type-meta) var(--font-mono); letter-spacing:.1em; text-transform:uppercase; }
  .ai-intro small { color:var(--color-signal); }
  .ai-field { display:grid; grid-template-columns:repeat(12,1fr); gap:var(--grid-gap); align-items:center; margin-top:clamp(10rem,18vw,17rem); }
  .ai-product :global(.task-trace) { grid-column:2 / span 7; }
  .ai-questions { grid-column:9 / span 4; align-self:center; }
  .ai-questions ul { margin:2rem 0 0; padding:0; list-style:none; }
  .ai-questions li { padding-block:1.25rem; border-top:1px solid var(--color-border); font:400 var(--type-lead)/1.25 var(--font-serif); text-wrap:pretty; }
  .ai-product blockquote { max-width:25ch; margin:clamp(10rem,18vw,18rem) 0 3rem 8%; font:400 var(--type-display-md)/1.05 var(--font-serif); letter-spacing:-.025em; }
  @media (max-width:640px) {
    .ai-product { min-height:auto; }.ai-intro { display:block; }.ai-intro h2 { font-size:clamp(3.25rem,15vw,5rem); }.ai-intro > div { margin-top:2rem; }
    .ai-field { display:block; margin-top:7rem; }.ai-questions { margin-top:6rem; }.ai-product blockquote { margin:8rem 0 3rem; }
  }
</style>
