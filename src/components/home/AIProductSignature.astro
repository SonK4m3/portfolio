---
import Container from '../primitives/Container.astro';
import Link from '../typography/Link.astro';
const lifecycle = ['Intent','Context','Generate','Verify','Recover','Return'];
const questions = ['What has started?','What is still running?','Can the user leave?','Can they return?','What happens if it fails?','Can it retry?','Where does the output go?'];
---
<section class="ai-product" data-ai-product aria-labelledby="ai-product-title"><Container><p class="ai-kicker">AI product</p><div class="ai-intro"><h2 id="ai-product-title">Generation is easy.<br />Reliability is<br />the product.</h2><div><p>AI changes more than the output. It changes how we design for context, waiting, progress, retries, failure, persistence, and what happens when a task continues after the user moves on.</p><p>I’m interested in building those systems — not just calling the model.</p></div></div><ol class="ai-lifecycle" data-ai-lifecycle aria-label="Reliable AI product lifecycle">{lifecycle.map((step,index)=><li data-ai-stage aria-current={index === 0 ? 'step' : undefined}><span>{String(index+1).padStart(2,'0')}</span><strong>{step}</strong></li>)}</ol><div class="ai-questions"><p>Product questions</p><ul>{questions.map(question=><li>{question}</li>)}</ul></div><blockquote>AI should feel like a capability inside the product, not a machine the user has to manage.</blockquote><Link href="/work/notex#making-ai-feel-like-product" variant="arrow">Explore AI inside NoteX</Link></Container></section>
<style>
  .ai-product { padding-block:clamp(7rem,14vw,13rem); border-top:1px solid var(--color-border); }.ai-kicker,.ai-lifecycle span,.ai-questions > p { color:var(--color-muted); font:500 var(--type-meta) var(--font-mono); letter-spacing:.1em; text-transform:uppercase; }.ai-intro { display:grid; grid-template-columns:repeat(12,1fr); gap:var(--grid-gap); margin-top:3rem; }.ai-intro h2 { grid-column:1 / span 8; font:560 var(--type-display-xl)/.91 var(--font-sans); letter-spacing:-.045em; text-transform:uppercase; }.ai-intro > div { grid-column:9 / span 4; align-self:end; display:grid; gap:1.2rem; color:var(--color-muted); font-size:var(--type-body); }.ai-lifecycle { display:grid; grid-template-columns:repeat(12,1fr); align-items:start; margin:8rem 0 0; padding:0; list-style:none; }.ai-lifecycle li { display:grid; gap:3rem; min-height:11rem; padding:1rem 0; border-top:1px solid var(--color-line); opacity:.68; }.ai-lifecycle li:nth-child(1) { grid-column:1 / span 2; }.ai-lifecycle li:nth-child(2) { grid-column:3 / span 2; margin-top:2rem; }.ai-lifecycle li:nth-child(3) { grid-column:5 / span 2; margin-top:4rem; }.ai-lifecycle li:nth-child(4) { grid-column:7 / span 2; margin-top:6rem; }.ai-lifecycle li:nth-child(5) { grid-column:9 / span 2; margin-top:8rem; }.ai-lifecycle li:nth-child(6) { grid-column:11 / span 2; margin-top:10rem; }.ai-lifecycle li[aria-current='step'] { color:var(--color-text); opacity:1; border-top:2px solid var(--color-accent); }.ai-lifecycle li[aria-current='step'] span::before { content:'● '; color:var(--color-accent); }.ai-lifecycle strong { align-self:end; font-size:clamp(1.15rem,2vw,2rem); text-transform:uppercase; }.ai-questions { display:grid; grid-template-columns:repeat(12,1fr); gap:var(--grid-gap); margin-top:10rem; }.ai-questions > p { grid-column:1 / span 3; }.ai-questions ul { grid-column:5 / span 8; display:grid; grid-template-columns:1fr 1fr; gap:0 var(--grid-gap); margin:0; padding:0; list-style:none; }.ai-questions li { padding-block:.8rem; border-top:1px solid var(--color-border); font-size:clamp(1.25rem,2vw,2rem); text-transform:uppercase; }.ai-product blockquote { max-width:24ch; margin:8rem 0 3rem; font:400 var(--type-display-md)/1.05 var(--font-serif); letter-spacing:-.025em; }
  @media (max-width:1199px) and (min-width:641px) { .ai-intro,.ai-questions { grid-template-columns:repeat(8,1fr); }.ai-intro h2 { grid-column:1 / span 6; }.ai-intro > div { grid-column:6 / span 3; }.ai-questions > p { grid-column:1 / span 2; }.ai-questions ul { grid-column:3 / span 6; } }
  @media (max-width:640px) { .ai-intro { display:block; }.ai-intro h2 { font-size:clamp(3.25rem,15vw,5rem); }.ai-intro > div { margin-top:2rem; }.ai-lifecycle { display:block; margin-top:5rem; }.ai-lifecycle li,.ai-lifecycle li:nth-child(n) { display:grid; grid-template-columns:2rem 1fr; min-height:auto; margin:0; gap:1rem; padding-block:1rem; border-top:0; border-bottom:1px solid var(--color-border); }.ai-lifecycle li[aria-current='step'] { border-top:0; }.ai-questions { display:block; margin-top:6rem; }.ai-questions ul { display:block; margin-top:2rem; } }
</style>
