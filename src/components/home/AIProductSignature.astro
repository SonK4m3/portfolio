---
import Container from '../primitives/Container.astro';
import Link from '../typography/Link.astro';
const lifecycle = ['Intent','Context','Generate','Verify','Recover','Return'];
const questions = ['What has started?','What is still running?','Can the user leave?','Can they return?','What happens if it fails?','Can it retry?','Where does the output go?'];
---
<section class="ai-product" data-ai-product aria-labelledby="ai-product-title"><Container><p class="ai-kicker">AI product</p><div class="ai-intro"><h2 id="ai-product-title">Generation is easy.<br />Reliability is<br />the product.</h2><div><p>AI changes more than the output. It changes how we design for context, waiting, progress, retries, failure, persistence, and what happens when a task continues after the user moves on.</p><p>I’m interested in building those systems — not just calling the model.</p></div></div><ol class="ai-lifecycle" data-ai-lifecycle aria-label="Reliable AI product lifecycle">{lifecycle.map((step,index)=><li data-ai-stage aria-current={index === 0 ? 'step' : undefined}><span>{String(index+1).padStart(2,'0')}</span><strong>{step}</strong></li>)}</ol><div class="ai-questions"><p>Product questions</p><ul>{questions.map(question=><li>{question}</li>)}</ul></div><blockquote>AI should feel like a capability inside the product, not a machine the user has to manage.</blockquote><Link href="/work/notex#making-ai-feel-like-product" variant="arrow">Explore AI inside NoteX</Link></Container></section>
<script is:inline>
  const product = document.querySelector('[data-ai-product]');
  const stages = [...document.querySelectorAll('[data-ai-stage]')];
  if (product && stages.length) {
    let frame;
    const updateStage = () => {
      frame = undefined;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const bounds = product.getBoundingClientRect();
      const travelled = innerHeight * .68 - bounds.top;
      const available = Math.max(1, bounds.height - innerHeight * .45);
      const index = Math.min(stages.length - 1, Math.max(0, Math.floor((travelled / available) * stages.length)));
      stages.forEach((stage, stageIndex) => {
        if (stageIndex === index) stage.setAttribute('aria-current', 'step');
        else stage.removeAttribute('aria-current');
      });
    };
    const requestUpdate = () => { if (!frame) frame = requestAnimationFrame(updateStage); };
    addEventListener('scroll', requestUpdate, { passive: true });
    addEventListener('resize', requestUpdate, { passive: true });
    updateStage();
  }
</script>
<style>
  .ai-product { padding-block:clamp(7rem,14vw,13rem); border-top:1px solid var(--color-border); }.ai-kicker,.ai-lifecycle span,.ai-questions > p { color:var(--color-muted); font:500 var(--type-meta) var(--font-mono); letter-spacing:.1em; text-transform:uppercase; }.ai-intro { display:grid; grid-template-columns:repeat(12,1fr); gap:var(--grid-gap); margin-top:3rem; }.ai-intro h2 { grid-column:1 / span 8; font:560 var(--type-display-xl)/.91 var(--font-sans); letter-spacing:-.045em; text-transform:uppercase; }.ai-intro > div { grid-column:9 / span 4; align-self:end; display:grid; gap:1.2rem; color:var(--color-muted); font-size:var(--type-body); }.ai-lifecycle { position:relative; display:grid; grid-template-columns:repeat(6,1fr); margin:8rem 0 0; padding:0; border-top:1px solid var(--color-border); list-style:none; }.ai-lifecycle::before { content:''; position:absolute; top:-1px; left:0; width:calc((var(--active-stage, 1) / 6) * 100%); height:2px; background:var(--color-accent); transition:width var(--duration-base) var(--ease-system); }.ai-lifecycle li { display:grid; gap:3rem; min-height:10rem; padding:1rem; border-right:1px solid var(--color-border); opacity:.46; transition:opacity var(--duration-base) var(--ease-system), color var(--duration-base) var(--ease-system); }.ai-lifecycle li:last-child { border-right:0; }.ai-lifecycle li[aria-current='step'] { color:var(--color-text); opacity:1; }.ai-lifecycle li[aria-current='step'] span::before { content:'● '; color:var(--color-accent); }.ai-lifecycle strong { align-self:end; text-transform:uppercase; }.ai-questions { display:grid; grid-template-columns:repeat(12,1fr); gap:var(--grid-gap); margin-top:7rem; }.ai-questions > p { grid-column:1 / span 3; }.ai-questions ul { grid-column:5 / span 8; margin:0; padding:0; list-style:none; }.ai-questions li { padding-block:.8rem; border-bottom:1px solid var(--color-border); font-size:clamp(1.25rem,2vw,2rem); text-transform:uppercase; }.ai-product blockquote { max-width:24ch; margin:8rem 0 3rem; font:400 var(--type-display-md)/1.05 var(--font-serif); letter-spacing:-.025em; }
  .ai-lifecycle:has(li:nth-child(1)[aria-current='step']) { --active-stage:1; }.ai-lifecycle:has(li:nth-child(2)[aria-current='step']) { --active-stage:2; }.ai-lifecycle:has(li:nth-child(3)[aria-current='step']) { --active-stage:3; }.ai-lifecycle:has(li:nth-child(4)[aria-current='step']) { --active-stage:4; }.ai-lifecycle:has(li:nth-child(5)[aria-current='step']) { --active-stage:5; }.ai-lifecycle:has(li:nth-child(6)[aria-current='step']) { --active-stage:6; }
  @media (max-width:1199px) and (min-width:641px) { .ai-intro,.ai-questions { grid-template-columns:repeat(8,1fr); }.ai-intro h2 { grid-column:1 / span 6; }.ai-intro > div { grid-column:6 / span 3; }.ai-questions > p { grid-column:1 / span 2; }.ai-questions ul { grid-column:3 / span 6; } }
  @media (max-width:640px) { .ai-intro { display:block; }.ai-intro h2 { font-size:clamp(3.25rem,15vw,5rem); }.ai-intro > div { margin-top:2rem; }.ai-lifecycle { grid-template-columns:1fr; }.ai-lifecycle::before { width:2px; height:calc((var(--active-stage, 1) / 6) * 100%); }.ai-lifecycle li { grid-template-columns:2rem 1fr; min-height:auto; gap:1rem; border-right:0; border-bottom:1px solid var(--color-border); }.ai-questions { display:block; }.ai-questions ul { margin-top:2rem; } }
</style>
