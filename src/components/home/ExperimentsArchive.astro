---
import Container from '../primitives/Container.astro';
import Link from '../typography/Link.astro';
const experiments = [
  { index:'001', title:'AI LaTeX Generator', category:'AI systems', year:'2026', description:'Exploring how AI can generate, validate, and repair structured documents.' },
  { index:'002', title:'AI Skills', category:'AI / Tools', year:'2026', description:'Small reusable experiments around AI workflows, context, tools, and product capabilities.' },
];
---
<section class="experiments" aria-labelledby="experiments-title"><Container><p class="experiments-kicker">Playground</p><div class="experiments-intro"><h2 id="experiments-title">Experiments,<br />tools,<br />unfinished ideas.</h2><p>Not everything I build needs to become a product. Sometimes the point is to understand a system better.</p></div><div class="experiment-list">{experiments.map(item=><article><span>{item.index}</span><div><h3>{item.title}</h3><p>{item.description}</p></div><span>{item.category}</span><time>{item.year}</time></article>)}</div><Link href="/playground" variant="arrow">Open playground</Link></Container></section>
<style>
  .experiments { padding-block:clamp(7rem,14vw,13rem); border-top:1px solid var(--color-border); }.experiments-kicker,.experiment-list > article > span,.experiment-list time { color:var(--color-muted); font:600 .7rem var(--font-mono); letter-spacing:.1em; text-transform:uppercase; }.experiments-intro { display:grid; grid-template-columns:repeat(12,1fr); gap:1rem; margin-top:3rem; }.experiments-intro h2 { grid-column:1 / span 8; font-size:clamp(4rem,8vw,8rem); line-height:.82; letter-spacing:-.075em; text-transform:uppercase; }.experiments-intro > p { grid-column:9 / span 4; align-self:end; color:var(--color-muted); font-size:1.1rem; }.experiment-list { margin-block:7rem 3rem; border-top:1px solid var(--color-border); }.experiment-list article { display:grid; grid-template-columns:5rem 1fr 12rem 4rem; gap:1rem; align-items:start; padding-block:1.5rem; border-bottom:1px solid var(--color-border); }.experiment-list h3 { font-size:clamp(1.5rem,3vw,2.5rem); }.experiment-list div p { max-width:38rem; margin-top:.75rem; color:var(--color-muted); }
  @media (max-width:640px) { .experiments-intro { display:block; }.experiments-intro h2 { font-size:clamp(3.5rem,16vw,5rem); }.experiments-intro > p { margin-top:2rem; }.experiment-list article { grid-template-columns:2.5rem 1fr; }.experiment-list article > span:nth-of-type(2),.experiment-list time { grid-column:2; } }
</style>
