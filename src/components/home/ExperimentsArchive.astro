---
import Container from '../primitives/Container.astro';
import Link from '../typography/Link.astro';
const experiments = [
  { index:'001', title:'AI LaTeX Generator', category:'AI systems', year:'2026', description:'Testing a generate → compile → diagnose → repair loop for structured documents.' },
  { index:'002', title:'AI Skills', category:'AI / Tools', year:'2026', description:'Small reusable experiments around context, tools, and product capabilities.' },
];
---
<section class="experiments density-balanced" aria-labelledby="experiments-title" data-density="balanced">
  <Container>
    <div class="experiments-layout">
      <div class="experiments-archive">
        <h2 id="experiments-title">Playground</h2>
        <div class="experiment-list">{experiments.map(item=><article><span>{item.index}</span><div><h3>{item.title}</h3><p>{item.description}</p></div><small>{item.category} / {item.year}</small></article>)}</div>
        <Link href="/playground" variant="arrow">Open playground</Link>
      </div>
      <figure class="experiment-evidence media-offset"><figcaption><span>EXP.001 / DETAIL CROP</span><small>[ASSET REQUIRED]</small></figcaption><div><strong>Generated PDF<br />+ repair trace</strong><p>Add a tight, real artifact crop from the experiment.</p></div></figure>
    </div>
  </Container>
</section>
<style>
  .experiments { min-height:82svh; border-top:1px solid var(--color-border); }
  .experiments-layout { display:grid; grid-template-columns:repeat(12,1fr); gap:var(--grid-gap); align-items:center; }
  .experiments-archive { grid-column:1 / span 5; }
  h2 { font:560 var(--type-display-lg)/.91 var(--font-sans); letter-spacing:-.04em; text-transform:uppercase; }
  .experiment-list { margin-block:4rem 2rem; border-top:1px solid var(--color-border); }
  article { display:grid; grid-template-columns:3rem 1fr; gap:var(--grid-gap); padding-block:1.5rem; border-bottom:1px solid var(--color-border); }
  article > span,article small,.experiment-evidence figcaption { color:var(--color-muted); font:500 var(--type-meta) var(--font-mono); letter-spacing:.1em; text-transform:uppercase; }
  article h3 { font-size:clamp(1.4rem,2vw,2rem); line-height:1; text-transform:uppercase; }
  article p { margin-top:.75rem; color:var(--color-muted); font-size:var(--type-small); text-wrap:pretty; }
  article small { grid-column:2; }
  .experiment-evidence { grid-column:7 / -1; width:100%; margin:0; border-block:1px solid var(--color-border); }
  .experiment-evidence figcaption { display:flex; justify-content:space-between; padding-block:1rem; }
  .experiment-evidence figcaption small { color:var(--color-accent); font:inherit; }
  .experiment-evidence > div { min-height:34rem; display:grid; align-content:center; justify-items:center; gap:1rem; border-top:1px solid var(--color-border); background:var(--color-surface); text-align:center; }
  .experiment-evidence strong { font:400 var(--type-heading)/1 var(--font-serif); text-wrap:balance; }
  .experiment-evidence p { max-width:24ch; color:var(--color-muted); text-wrap:pretty; }
  @media (max-width:640px) {
    .experiments { min-height:auto; }
    .experiments-layout { display:block; }
    h2 { font-size:clamp(3.5rem,16vw,5rem); }
    .experiment-evidence { margin-top:5rem; }
    .experiment-evidence > div { min-height:22rem; padding:2rem 1rem; }
  }
</style>
