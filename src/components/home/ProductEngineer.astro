---
import Container from '../primitives/Container.astro';
const responsibilities = ['Product flow','UI / UX','Frontend architecture','FE technical decisions','Solution review','Team review','Platform evolution'];
---
<section class="product-engineer" aria-labelledby="product-engineer-title"><Container><p class="section-kicker">Product engineer / role scope</p><div class="product-engineer-intro"><h2 id="product-engineer-title">What I own.</h2><p>From clarifying the flow to reviewing the system that ships it.</p></div><ol class="ownership-list">{responsibilities.map((item,index)=><li><span>{String(index+1).padStart(2,'0')}</span><strong>{item}</strong></li>)}</ol></Container></section>
<style>
  .product-engineer { padding-block:clamp(5rem,9vw,8rem); border-top:1px solid var(--color-border); }.section-kicker,.ownership-list span { color:var(--color-muted); font:600 .7rem var(--font-mono); letter-spacing:.1em; text-transform:uppercase; }.product-engineer-intro { display:grid; grid-template-columns:repeat(12,1fr); gap:var(--grid-gap); margin-top:3rem; }.product-engineer-intro h2 { grid-column:1 / span 5; font-size:clamp(3rem,6vw,6rem); line-height:.92; letter-spacing:-.04em; text-transform:uppercase; }.product-engineer-intro p { grid-column:9 / span 4; align-self:end; max-width:30ch; color:var(--color-muted); font-size:1.1rem; text-wrap:pretty; }.ownership-list { display:grid; grid-template-columns:repeat(4,1fr); gap:0 var(--grid-gap); margin:5rem 0 0; padding:0; border-top:1px solid var(--color-border); list-style:none; }.ownership-list li { display:grid; grid-template-columns:2rem 1fr; gap:1rem; align-items:baseline; min-height:6rem; padding:1rem 0; border-bottom:1px solid var(--color-border); }.ownership-list li:nth-child(5) { grid-column:2; }.ownership-list strong { font-size:clamp(1rem,1.4vw,1.35rem); line-height:1.1; text-transform:uppercase; text-wrap:balance; }
  @media (max-width:640px) { .product-engineer-intro { display:block; }.product-engineer-intro p { margin-top:2rem; }.ownership-list { grid-template-columns:1fr 1fr; }.ownership-list li:nth-child(5) { grid-column:auto; }.ownership-list li { min-height:5rem; padding-right:1rem; } }
</style>
