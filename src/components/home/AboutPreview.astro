---
import Container from '../primitives/Container.astro';
import Link from '../typography/Link.astro';
---
<section class="about-home" aria-labelledby="about-home-title"><Container><p class="about-kicker">About</p><div class="about-grid"><div><h2 id="about-home-title">I’m a Product Engineer with a strong foundation in frontend architecture.</h2><p>I enjoy working where product thinking, interaction design, and technical systems overlap — especially when the problem is still ambiguous and the right solution has not been defined yet.</p><p>Most of my recent work has been focused on AI-native products.</p><Link href="/about" variant="arrow">About me</Link></div><strong>Building technology<br />that feels<br />considered.</strong></div></Container></section>
<style>
  .about-home { padding-block:clamp(7rem,14vw,13rem); border-top:1px solid var(--color-border); }.about-kicker { color:var(--color-muted); font:600 .7rem var(--font-mono); letter-spacing:.1em; text-transform:uppercase; }.about-grid { display:grid; grid-template-columns:repeat(12,1fr); gap:1rem; margin-top:3rem; }.about-grid > div { grid-column:1 / span 5; }.about-grid h2 { font-size:clamp(2rem,4vw,4rem); line-height:.98; letter-spacing:-.05em; }.about-grid p { margin-top:1.5rem; color:var(--color-muted); font-size:1.05rem; }.about-grid :global(.link) { margin-top:2rem; }.about-grid > strong { grid-column:7 / span 6; align-self:end; font-size:clamp(3rem,6vw,6rem); line-height:.88; letter-spacing:-.065em; text-transform:uppercase; }
  @media (max-width:640px) { .about-grid { display:block; }.about-grid > strong { display:block; margin-top:6rem; font-size:clamp(3rem,14vw,4.5rem); } }
</style>
