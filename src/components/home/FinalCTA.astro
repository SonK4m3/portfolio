---
import Container from '../primitives/Container.astro';
---
<section class="final-cta density-void" aria-labelledby="final-cta-title" data-density="void"><Container><h2 id="final-cta-title">Build something<br />thoughtful.</h2><div><p>Have an interesting product or technical problem?</p><span class="conversation-cta">Start a conversation → <small>[EMAIL TBD]</small></span></div></Container></section>
<style>
  .final-cta { min-height:88svh; display:grid; align-items:center; border-top:1px solid var(--color-border); }.final-cta :global(.container) { display:grid; grid-template-columns:repeat(12,1fr); gap:1rem; }.final-cta h2 { grid-column:1 / span 8; font-size:clamp(4rem,9vw,9rem); line-height:.82; letter-spacing:-.04em; text-transform:uppercase; }.final-cta > :global(.container) > div { grid-column:9 / span 4; align-self:end; }.final-cta p { color:var(--color-muted); font-size:1.1rem; }.conversation-cta { display:inline-block; margin-top:2rem; border-bottom:1px solid currentColor; padding-bottom:.35rem; }.conversation-cta small { color:var(--color-muted); font:600 .65rem var(--font-mono); }
  @media (max-width:640px) { .final-cta { min-height:78svh; }.final-cta :global(.container) { display:block; }.final-cta h2 { font-size:clamp(3.5rem,18vw,5.5rem); }.final-cta > :global(.container) > div { margin-top:3rem; } }
</style>
