---
import Container from '../primitives/Container.astro';
---
<section class="final-cta" aria-labelledby="final-cta-title"><Container><h2 id="final-cta-title">Build something<br />thoughtful.</h2><div><p>I’m interested in ambitious products, unusual technical problems, and collaborations where quality matters.</p><span class="conversation-cta">Start a conversation → <small>[EMAIL TBD]</small></span></div></Container></section>
<style>
  .final-cta { padding-block:clamp(8rem,17vw,16rem); border-top:1px solid var(--color-border); }.final-cta :global(.container) { display:grid; grid-template-columns:repeat(12,1fr); gap:1rem; }.final-cta h2 { grid-column:1 / span 8; font-size:clamp(4rem,9vw,9rem); line-height:.82; letter-spacing:-.08em; text-transform:uppercase; }.final-cta > :global(.container) > div { grid-column:9 / span 4; align-self:end; }.final-cta p { color:var(--color-muted); font-size:1.1rem; }.conversation-cta { display:inline-block; margin-top:2rem; border-bottom:1px solid currentColor; padding-bottom:.35rem; }.conversation-cta small { color:var(--color-muted); font:600 .65rem var(--font-mono); }
  @media (max-width:640px) { .final-cta :global(.container) { display:block; }.final-cta h2 { font-size:clamp(3.5rem,18vw,5.5rem); }.final-cta > :global(.container) > div { margin-top:3rem; } }
</style>
