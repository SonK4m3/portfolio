---
import { componentStatusCopy, type ComponentStatus } from '../../lib/components/status';
export interface Props { status: ComponentStatus; showDescription?: boolean }
const { status, showDescription = false } = Astro.props as Props;
---
<span class="component-status" title={componentStatusCopy[status]}>
  <i aria-hidden="true"></i><strong>{status}</strong>
  {showDescription && <small>{componentStatusCopy[status]}</small>}
</span>
<style>
  .component-status { display:inline-flex; align-items:center; gap:var(--space-2); color:var(--color-muted); font:500 var(--type-meta)/1.3 var(--font-mono); letter-spacing:.1em; text-transform:uppercase; }
  i { width:.5rem; height:.5rem; border:1px solid currentColor; border-radius:50%; }
  strong { color:var(--color-foreground); font:inherit; }
  small { max-width:30ch; font:inherit; letter-spacing:0; text-transform:none; }
  .component-status:has(strong:first-of-type) i { border-color:var(--color-signal); }
</style>
