---
export interface ApiProperty { name: string; type: string; default?: string; description: string }
export interface Props { properties: ApiProperty[] }
const { properties } = Astro.props as Props;
---
<div class="api-table">
  <table>
    <thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
    <tbody>{properties.map((property) => <tr><th scope="row"><code>{property.name}</code></th><td><code>{property.type}</code></td><td><code>{property.default ?? '—'}</code></td><td>{property.description}</td></tr>)}</tbody>
  </table>
  <dl>{properties.map((property) => <div><dt><code>{property.name}</code></dt><dd><span>Type</span><code>{property.type}</code></dd><dd><span>Default</span><code>{property.default ?? '—'}</code></dd><dd>{property.description}</dd></div>)}</dl>
</div>
<style>
  table { width:100%; border-collapse:collapse; font-size:var(--type-small); }
  th,td { padding:var(--space-4) var(--space-3); border-bottom:1px solid var(--color-border); text-align:left; vertical-align:top; }
  thead th { color:var(--color-muted); font:500 var(--type-meta)/1.2 var(--font-mono); letter-spacing:.1em; text-transform:uppercase; }
  tbody th { font-weight:500; }
  code { color:var(--color-foreground); font-family:var(--font-mono); font-size:.82em; overflow-wrap:anywhere; }
  td:last-child { color:var(--color-muted); }
  dl { display:none; margin:0; }
  @media (max-width:720px) { table { display:none; } dl { display:grid; } dl > div { display:grid; grid-template-columns:1fr 1fr; gap:var(--space-3); padding:var(--space-5) 0; border-bottom:1px solid var(--color-border); } dt { grid-column:1 / -1; font-weight:600; } dd { display:grid; gap:var(--space-1); margin:0; color:var(--color-muted); font-size:var(--type-small); } dd:last-child { grid-column:1 / -1; } dd span { font:500 var(--type-meta)/1.2 var(--font-mono); letter-spacing:.08em; text-transform:uppercase; } }
</style>
