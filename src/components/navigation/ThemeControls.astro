<div class="theme-controls"><button type="button" data-theme-toggle aria-label="Toggle color theme" aria-pressed="false"><svg width="16" height="16" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7" fill="none" stroke="currentColor" stroke-width="1.2" /><path d="M10 3a7 7 0 0 1 0 14Z" fill="currentColor" /></svg><span data-theme-label>Light</span></button></div>
<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const label = button?.querySelector<HTMLElement>('[data-theme-label]');
  const sync = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    button?.setAttribute('aria-pressed', String(dark));
    if (label) label.textContent = dark ? 'Dark' : 'Light';
  };
  button?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('portfolio-theme', next); } catch { /* A theme change still works without storage. */ }
    sync();
  });
  sync();
</script>
<style>
  .theme-controls { display:flex; align-items:center; justify-content:end; color:var(--muted); }
  button { appearance:none; display:flex; gap:.6rem; align-items:center; min-height:2.75rem; min-width:2.75rem; border:0; padding:.5rem; background:transparent; color:inherit; cursor:pointer; font-size:.6875rem; }
  button:hover { color:var(--text); }
  @media (scripting:none) { .theme-controls { display:none; } }
</style>
