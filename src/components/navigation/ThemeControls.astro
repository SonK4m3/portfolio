<div class="theme-controls" aria-label="Display preferences">
  <span class="language" aria-label="English selected; Vietnamese localization is planned"><strong>EN</strong><span aria-hidden="true">/</span><span>VI</span></span>
  <button type="button" data-theme-toggle aria-label="Toggle color theme" aria-pressed="false"><span data-theme-label>Light / Dark</span></button>
</div>
<script is:inline>
  const button = document.querySelector('[data-theme-toggle]');
  const label = button?.querySelector('[data-theme-label]');
  const sync = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    button?.setAttribute('aria-pressed', String(dark));
    if (label) label.textContent = dark ? 'Dark / Light' : 'Light / Dark';
  };
  button?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('portfolio-theme', next);
    sync();
  });
  sync();
</script>
<style>
  .theme-controls { display:flex; align-items:center; gap:var(--space-5); color:var(--color-muted); font:500 .68rem/1 var(--font-mono); letter-spacing:.08em; text-transform:uppercase; }
  .language { display:flex; gap:.35rem; }.language strong { color:var(--color-text); font-weight:500; }.language span:last-child { opacity:.55; }
  button { appearance:none; border:0; padding:0; background:transparent; color:inherit; cursor:pointer; text-transform:uppercase; }
  button:hover { color:var(--color-text); }
  button[aria-pressed='true'] [data-theme-label] { color:var(--color-accent); }
  @media (max-width:640px) { .theme-controls { gap:var(--space-3); }.language { display:none; } }
</style>
