---
import FigureLabel from '../editorial/FigureLabel.astro';
export interface ArchitectureLayer { id: string; label: string; meta?: string; description?: string }
export interface Props { className?: string; id?: string; layers: ArchitectureLayer[]; activeLayer?: string; figureIndex?: string; title?: string; verification?: string }
const { className = '', id, layers, activeLayer, figureIndex = '02', title = 'STATE / OWNERSHIP', verification } = Astro.props as Props;
---
<figure id={id} class:list={['architecture-layers', className]} data-architecture-layers>
  <FigureLabel type="SYS" index={figureIndex} title={title} signal={verification} />
  <ol>
    {layers.map((layer,index) => <li class:list={['layer', { active: layer.id === activeLayer }]} data-layer={layer.id}>
      <span>{String(index + 1).padStart(2,'0')}</span>
      <div><strong>{layer.label}</strong>{layer.meta && <small>{layer.meta}</small>}</div>
      {layer.description && <p>{layer.description}</p>}
    </li>)}
  </ol>
</figure>
<style>
  .architecture-layers { margin:0; }
  ol { display:grid; gap:var(--space-3); margin:0; padding:0; list-style:none; }
  .layer { display:grid; grid-template-columns:3rem minmax(10rem,3fr) minmax(14rem,5fr); gap:var(--grid-gap); align-items:center; min-height:6rem; padding:var(--space-4); border:1px solid var(--color-border); background:var(--color-background); transition:opacity var(--motion-fast) var(--ease-system),border-color var(--motion-fast) var(--ease-system); }
  .layer > span,.layer small { color:var(--color-muted); font:500 var(--type-meta)/1.3 var(--font-mono); letter-spacing:.1em; text-transform:uppercase; }
  .layer div { display:grid; gap:var(--space-2); }
  .layer strong { font:600 var(--type-subheading)/1 var(--font-sans); letter-spacing:-.03em; text-transform:uppercase; text-wrap:balance; }
  .layer p { max-width:44ch; color:var(--color-muted); font-size:var(--type-small); text-wrap:pretty; }
  .layer.active { border-color:var(--color-signal); }
  .layer.active > span { color:var(--color-signal); }
  @media (hover:hover) { ol:hover .layer:not(:hover):not(.active) { opacity:.45; }.layer:hover { border-color:var(--color-foreground); } }
  @media (max-width:640px) { .layer { grid-template-columns:2rem 1fr; }.layer p { grid-column:2; } }
  @media (prefers-reduced-motion:reduce) { .layer { transition-duration:.01ms; } }
</style>
